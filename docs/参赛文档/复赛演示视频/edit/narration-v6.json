{
  "status": "script-ready-awaiting-voice-provider",
  "lang": "zh",
  "duration": 270,
  "bgm": {
    "mode": "none"
  },
  "delivery": "自然、清晰的普通话产品演示语气，语速适中，不模仿真人，不使用播音腔",
  "lines": [
    {
      "id": "01",
      "scene": "opening",
      "start": 0.15,
      "end": 4,
      "text": "先看整理结果，再看三端共创。"
    },
    {
      "id": "02",
      "scene": "opening",
      "start": 4.2,
      "end": 7.7,
      "text": "FlowMuse，流形白板。"
    },
    {
      "id": "03",
      "scene": "library",
      "start": 8.5,
      "end": 15.7,
      "text": "先用笔记本归拢课程资料，再配上标签，之后就能按主题查找。"
    },
    {
      "id": "04",
      "scene": "library",
      "start": 16.05,
      "end": 24.35,
      "text": "新建笔记，选择分页或无界画布，再通过鸿蒙原生能力导入 PDF。"
    },
    {
      "id": "05",
      "scene": "library",
      "start": 25,
      "end": 35.3,
      "text": "复习时按标题搜索讲义，打开以后，就能继续阅读和记录。"
    },
    {
      "id": "06",
      "scene": "brushes",
      "start": 36.4,
      "end": 42,
      "text": "用毛笔写下标题，让笔记保留手写的笔触和节奏。"
    },
    {
      "id": "07",
      "scene": "brushes",
      "start": 42.5,
      "end": 49,
      "text": "换成铅笔画出二叉树，文字和图示都留在这块画布上。"
    },
    {
      "id": "08",
      "scene": "brushes",
      "start": 49.6,
      "end": 63.5,
      "text": "接着写下几种遍历的要点，在图形旁边直接补充说明，把思考过程一起记下来。"
    },
    {
      "id": "09",
      "scene": "brushes",
      "start": 64,
      "end": 67.6,
      "text": "最后，用荧光笔标出重点。"
    },
    {
      "id": "10",
      "scene": "recognition",
      "start": 68.3,
      "end": 75.5,
      "text": "选中刚写好的内容，一键转成文字，还能修改字号和位置。"
    },
    {
      "id": "11",
      "scene": "recognition",
      "start": 76,
      "end": 86.1,
      "text": "也可以开启边写边识别与自动排布，继续落笔，文字就会逐段转换并排齐。"
    },
    {
      "id": "12",
      "scene": "recognition",
      "start": 86.9,
      "end": 94.5,
      "text": "再用鸿蒙原生语音识别补充一句话，口述内容同样能写入白板。"
    },
    {
      "id": "13",
      "scene": "layout",
      "start": 95.25,
      "end": 99,
      "text": "这一页写完了，我们来整理一下。"
    },
    {
      "id": "14",
      "scene": "layout",
      "start": 99.4,
      "end": 107.6,
      "text": "智能排版先给出候选，在不同方案之间切换，比较哪种更适合这一页。"
    },
    {
      "id": "15",
      "scene": "layout",
      "start": 108,
      "end": 118.4,
      "text": "把结果和原稿并排对照，检查标题、图示和说明的位置，看看内容之间的关系有没有保留下来。"
    },
    {
      "id": "16",
      "scene": "layout",
      "start": 119,
      "end": 124.1,
      "text": "确认合适以后，再应用到白板，接着编辑。"
    },
    {
      "id": "17",
      "scene": "layout",
      "start": 124.6,
      "end": 129.8,
      "text": "如果不满意，一次撤销就能回到原稿。"
    },
    {
      "id": "18",
      "scene": "layout",
      "start": 130.1,
      "end": 134.6,
      "text": "也能通过重做，恢复刚才的整理结果。"
    },
    {
      "id": "19",
      "scene": "ai",
      "start": 135.4,
      "end": 144.2,
      "text": "打开 AI 助手，选取笔记内容，发起总结，先梳理这一页的要点。"
    },
    {
      "id": "20",
      "scene": "ai",
      "start": 145,
      "end": 156.1,
      "text": "生成以后，先看内容，再确认写回白板。文字落在画布上，还能调整位置。"
    },
    {
      "id": "21",
      "scene": "ai",
      "start": 157,
      "end": 162.8,
      "text": "继续生成思维导图，让知识点之间的关系更直观。"
    },
    {
      "id": "22",
      "scene": "ai",
      "start": 163.35,
      "end": 170.5,
      "text": "确认以后，导图写入画布，还能选中和移动，继续安排页面。"
    },
    {
      "id": "23",
      "scene": "collab",
      "start": 171.15,
      "end": 173.75,
      "text": "接着，邀请好友加入。"
    },
    {
      "id": "24",
      "scene": "collab",
      "start": 174.1,
      "end": 182.8,
      "text": "创建协作房间，向好友发出邀请。对方加入后，就能进入同一块白板。"
    },
    {
      "id": "25",
      "scene": "collab",
      "start": 183.4,
      "end": 189,
      "text": "鸿蒙、安卓和网页端，都能加入这场协作。"
    },
    {
      "id": "26",
      "scene": "collab",
      "start": 189.6,
      "end": 207.2,
      "text": "成员各自书写，新增的笔迹会同步到其他端。通过成员光标，可以看清谁正在补充，一起把这份笔记写完整。"
    },
    {
      "id": "27",
      "scene": "collab",
      "start": 208,
      "end": 214.5,
      "text": "点击成员头像，聚焦他的贡献，其他成员的笔迹会变淡。"
    },
    {
      "id": "28",
      "scene": "openness",
      "start": 215.4,
      "end": 227.4,
      "text": "打开文本面板，查看图形对应的描述。移动画布上的图形，位置参数也会跟着更新。"
    },
    {
      "id": "29",
      "scene": "openness",
      "start": 228.2,
      "end": 235.3,
      "text": "把笔记分享为 Excalidraw 兼容文件，再重新打开。"
    },
    {
      "id": "30",
      "scene": "openness",
      "start": 235.65,
      "end": 239.6,
      "text": "图形仍能选中和修改，继续编辑。"
    },
    {
      "id": "31",
      "scene": "harmony",
      "start": 240.25,
      "end": 245.7,
      "text": "在鸿蒙桌面，点一下卡片，就能回到最近的笔记。"
    },
    {
      "id": "32",
      "scene": "harmony",
      "start": 246,
      "end": 248.35,
      "text": "也支持华为账号。"
    },
    {
      "id": "33",
      "scene": "harmony",
      "start": 249,
      "end": 261.4,
      "text": "通过系统取色，选取屏幕上的颜色，再回到白板落笔，把看到的蓝色和黄色用到笔记里。"
    },
    {
      "id": "34",
      "scene": "closing",
      "start": 262,
      "end": 266.05,
      "text": "留下笔迹，整理成页，和伙伴一起完善。"
    },
    {
      "id": "35",
      "scene": "closing",
      "start": 266.2,
      "end": 269.6,
      "text": "FlowMuse，青天小老爷团队。"
    }
  ]
}
