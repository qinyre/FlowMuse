{
  "name": "flowmuse-demo-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/prepare.mjs && remotion studio --no-open",
    "check": "node scripts/prepare.mjs && tsc --noEmit && node scripts/check-timing.mjs",
    "render:preview": "node scripts/prepare.mjs && remotion render src/index.ts FlowMusePreview ../output/FlowMuse-纸面预演-v4.mp4 --scale=0.6666666666666666 --codec=h264 --crf=23 --concurrency=4",
    "render:sample": "node scripts/prepare.mjs && remotion render src/index.ts FlowMuseStyleSample ../output/FlowMuse-纸面样片-v4.mp4 --codec=h264 --crf=20 --concurrency=3",
    "check:final": "node scripts/prepare.mjs --final",
    "render:clean": "node scripts/prepare.mjs --render-clean"
  },
  "dependencies": {
    "@remotion/captions": "4.0.528",
    "@remotion/cli": "4.0.528",
    "@remotion/fonts": "4.0.528",
    "@remotion/media": "4.0.528",
    "@remotion/transitions": "4.0.528",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@ffmpeg-installer/win32-x64": "4.1.0",
    "@ffprobe-installer/win32-x64": "5.1.0",
    "@fontsource/dm-sans": "5.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
