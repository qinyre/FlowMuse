# MyScript handwriting recognition
FLOWMUSE_MYSCRIPT_APP_KEY=
FLOWMUSE_MYSCRIPT_HMAC_KEY=
FLOWMUSE_MYSCRIPT_ENDPOINT=https://cloud.myscript.com/api/v4.0/iink/batch
FLOWMUSE_RECOGNITION_TIMEOUT=20s

# Public Web origin and links
# Migration: retain the old Web origins until local notes have been exported.
# Local development: add the exact Flutter Web origin (including its port).
FLOWMUSE_ALLOWED_ORIGINS=https://app.flowmuse.cloud,http://app.flowmuse.cloud,https://flowmuse.cloud,https://www.flowmuse.cloud,https://qinyre.github.io,http://localhost:8080,http://127.0.0.1:8080
FLOWMUSE_PUBLIC_APP_URL=https://app.flowmuse.cloud

# Friends/chat rollout switch; keep false until the deployed build is verified.
FLOWMUSE_SOCIAL_ENABLED=false

# SMTP (local Mailpit by default; see README for Resend production settings)
FLOWMUSE_SMTP_HOST=mailpit
FLOWMUSE_SMTP_PORT=1025
FLOWMUSE_SMTP_USERNAME=
FLOWMUSE_SMTP_PASSWORD=
FLOWMUSE_SMTP_FROM="FlowMuse <noreply@flowmuse.local>"

# Huawei Account Kit: application Client ID (not project Client ID).
# Keep the Client Secret on the server only. Empty credentials disable Huawei login.
FLOWMUSE_HUAWEI_CLIENT_ID=6917611606499874343
FLOWMUSE_HUAWEI_CLIENT_SECRET=

# Recognition HTTP request timeout
FLOWMUSE_AI_TIMEOUT=120s
